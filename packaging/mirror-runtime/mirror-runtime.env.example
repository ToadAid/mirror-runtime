# Mirror Runtime environment

MIRROR_PORT=7777
MIRROR_NODE_ID=mirror-node-local

# Required provider settings
MIRROR_PROVIDER_URL=https://provider.example/v1/chat/completions
MIRROR_PROVIDER_AUTH_TOKEN=replace-me

# Optional operator auth for write-capable commands
# MIRROR_OPERATOR_TOKEN=replace-me

# Optional externally reachable base URL for sync/peer announcements
# MIRROR_BASE_URL=https://mirror.example

# Linux-first directory conventions
MIRROR_LORE_DIR=%h/.local/share/mirror-runtime/lore-scrolls
MIRROR_MEMORY_DB_PATH=%h/.local/state/mirror-runtime/mirror-memory.db
