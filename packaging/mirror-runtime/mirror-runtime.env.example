# Mirror Runtime environment
# Structured user-facing settings live under ~/.mirror/config/

# Optional bootstrap/runtime overrides
# MIRROR_PORT=7777
# MIRROR_NODE_ID=mirror-node-local
# MIRROR_OPERATOR_TOKEN=replace-me
# MIRROR_BASE_URL=https://mirror.example

# Local-first workspace
# The bootstrap installer writes real user-specific paths into the installed env file.
MIRROR_WORKSPACE_ROOT=/home/your-user/.mirror/workspace
MIRROR_USER_WORKSPACE_DIR=/home/your-user/.mirror/workspace/users
MIRROR_LORE_DIR=/home/your-user/.mirror/workspace/lore
MIRROR_STATE_DIR=/home/your-user/.mirror/state
MIRROR_LOG_DIR=/home/your-user/.mirror/logs
MIRROR_MEMORY_DB_PATH=/home/your-user/.mirror/state/mirror-memory.db
